rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Static structures validation
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() <= 100
        && data.createdAt is string
        && data.createdAt.size() <= 100
        && data.updatedAt is string
        && data.updatedAt.size() <= 100;
    }

    function isValidGameSave(data) {
      return data.saveId is string
        && data.saveId.size() <= 128
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() <= 100
        && (data.turn is int || data.turn is float)
        && data.createdAt is string
        && data.createdAt.size() <= 100
        && data.updatedAt is string
        && data.updatedAt.size() <= 100;
    }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);
    }

    // 3. User Saves Collection
    match /users/{userId}/saves/{saveId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidGameSave(incoming());
      allow update: if isOwner(userId) && isValidGameSave(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
